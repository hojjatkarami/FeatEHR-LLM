# =============================================================================
# FeatEHR-LLM Environment & Model Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Active Model Configuration
# -----------------------------------------------------------------------------
# Specify your model name here. Examples:
#   Direct DeepSeek:       deepseek-chat  or  deepseek-reasoner
#   OpenRouter:            deepseek/deepseek-chat  or  google/gemini-2.5-flash
#   OpenAI:                gpt-4o-mini  or  gpt-4o
#   Google Gemini:         gemini-2.0-flash
LLM_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# 2. DeepSeek API (Official DeepSeek API: https://platform.deepseek.com)
# -----------------------------------------------------------------------------
# Used when model name starts with "deepseek" without provider slash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_URL=https://api.deepseek.com

# -----------------------------------------------------------------------------
# 3. OpenRouter / Generic OpenAI-Compatible Gateway
# -----------------------------------------------------------------------------
# Used when model name contains "/" (e.g. "deepseek/deepseek-chat", "meta-llama/...")
LLM_API_KEY=your_openrouter_api_key_here
BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# 4. OpenAI API (Optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# 5. Google Gemini API (Optional)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# -----------------------------------------------------------------------------
# 6. Weights & Biases Logging (Optional - defaults to disabled)
# -----------------------------------------------------------------------------
WANDB_MODE=disabled
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT=FeatEHR-LLM
