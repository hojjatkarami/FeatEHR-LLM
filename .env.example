# FeatEHR-LLM Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================
# OpenAI Configuration
# ===========================
# Used for models starting with "gpt-"
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_URL=https://api.openai.com/v1

# ===========================
# Generic LLM Configuration (OpenRouter, etc.)
# ===========================
# Used for models accessed through OpenRouter or other compatible APIs
# Models format: "provider/model-name" (e.g., "openai/gpt-4", "anthropic/claude-3.5-sonnet")
LLM_API_KEY=your_llm_api_key_here
BASE_URL=https://openrouter.ai/api/v1

# ===========================
# Google Gemini Configuration
# ===========================
# Used for models starting with "gemini-"
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ===========================
# Weights & Biases (Optional)
# ===========================
# Used for experiment tracking and logging
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT=FeatEHR-LLM
# WANDB_ENTITY=your_wandb_entity

# ===========================
# Data Configuration (Optional)
# ===========================
# Path to data directory (default: ./data)
# DATA_DIR=./data

# ===========================
# Model Configuration (Optional)
# ===========================
# Default LLM model to use
# LLM_MODEL=gpt-4o
